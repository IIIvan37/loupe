#!/bin/sh

# Node from .nvmrc + pnpm via Corepack (on WSL node isn't always on PATH).
if [ -z "$NVM_DIR" ]; then
  export NVM_DIR="$HOME/.nvm"
fi
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # Runtime-only path, nothing for shellcheck to follow statically.
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
  nvm use >/dev/null 2>&1 || true
fi
if ! command -v pnpm >/dev/null 2>&1 && command -v corepack >/dev/null 2>&1; then
  corepack enable >/dev/null 2>&1 || true
fi

# Staged files (added/copied/modified/renamed — deletions need no formatting).
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Doc-only fast path: a commit touching only *.md / docs/** skips the code gate
# — but NOT the docs fitness function (docs/docs.spec.ts, once it exists): the
# STATUS/session bounds exist precisely to catch doc commits, so exempting doc
# commits from them would hollow out the guard. commitlint still runs via the
# commit-msg hook; CI re-runs the full gate.
if [ -n "$staged" ] && ! printf '%s\n' "$staged" | grep -qvE '\.md$|^docs/'; then
  echo "📝 doc-only commit — skipping the code gate"
  if [ -f docs/docs.spec.ts ]; then
    echo "📝 running the docs fitness function"
    pnpm -s exec vitest run docs/docs.spec.ts
  fi
  exit 0
fi

# Format the staged files — but ONLY those with no unstaged edits. Formatting a
# partially staged file and re-adding it would sweep the unstaged hunks into the
# commit (`git add <path>` stages the whole working-tree content), silently
# destroying a careful `git add -p`. Those files are left untouched with a loud
# warning instead; the repo-wide `biome check` in CI is the backstop. (This is
# consistent with the rest of the hook: typecheck & tests read the working tree,
# not the index, so pre-commit was never a faithful index check.)
if [ -n "$staged" ]; then
  unstaged=$(git diff --name-only)
  fully_staged=""
  partially_staged=""
  for f in $staged; do
    if printf '%s\n' "$unstaged" | grep -qxF "$f"; then
      partially_staged="$partially_staged $f"
    else
      fully_staged="$fully_staged $f"
    fi
  done

  if [ -n "$fully_staged" ]; then
    echo "🔍 biome --write (fully staged files)"
    # $fully_staged is a space-separated list; the split is the point.
    # shellcheck disable=SC2086
    printf '%s\n' $fully_staged | xargs pnpm -s exec biome check --write --no-errors-on-unmatched
    # Same list, same intentional split.
    # shellcheck disable=SC2086
    printf '%s\n' $fully_staged | xargs git add --
  fi

  if [ -n "$partially_staged" ]; then
    echo "⚠️  partially staged (unstaged edits too) — NOT auto-formatted, to protect"
    echo "   your staged hunks. CI's repo-wide biome check is the backstop:"
    for f in $partially_staged; do echo "   - $f"; done
  fi
fi

# `pnpm gate` stamps the working tree it validated. If the tree still hashes to
# that stamp, these very checks already ran on these very bytes — replaying them
# would burn the loop's most expensive minutes to reprint the same green. Any
# difference (including the biome --write above, if it changed anything) misses
# the stamp and the full set runs. See scripts/gate-stamp.sh.
if bash scripts/gate-stamp.sh check; then
  echo "✅ gate already green on this exact tree (stamped) — skipping the replay"
  exit 0
fi

# Blocking guardrails (greenfield: no debt, so no tolerance). ONE regex, the
# same shape `gate` uses, minus repo-wide `check` (biome) — replaced by the
# staged-only pass above, so a partial commit isn't blocked by unformatted WIP
# files; CI covers the rest. A commit that passes here cannot fail CI on a
# skipped check.
#
# The regex form keeps the list from drifting INSIDE itself, the way a
# hand-maintained one does — `check:tokens` had already gone missing. It does
# nothing about the two lists: this one and `gate`'s in package.json are
# separate copies, and `check:tests` went missing from this one the day it was
# added. `docs/gate-parity.spec.ts` now refuses that drift at gate time.
# The parallelism the regex also brings is close to free but
# nearly worthless: measured on one tree, `test:coverage` alone is ~99 s, the
# whole parallel set ~106 s, the same set one after another ~108 s. Everything
# hides behind coverage either way. What actually removes the cost is the
# stamp above.
echo "🔍 gate (typecheck + arch + design + react + tokens + i18n + shell + tests + coverage + knip + jscpd)"
pnpm run "/^(typecheck|check:arch|check:design|check:react|check:tokens|check:i18n|check:sonar|check:shell|check:tests|test:coverage|check:dead|check:dup)$/"

# Everything the gate covers just passed on this tree — stamp it so an amend or
# a quick follow-up commit on the same bytes doesn't pay for it again.
bash scripts/gate-stamp.sh write

echo "✅ Pre-commit OK"
