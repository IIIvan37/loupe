{
  "name": "loupe",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.11.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:analysis": "cd server && .venv/bin/uvicorn app.main:app --port 8000",
    "dev:web": "pnpm --filter @app/web dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:diff": "node scripts/mutation-diff.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "check:arch": "sheriff verify",
    "check:design": "impeccable detect packages/web/src",
    "check:react": "react-doctor packages/web --blocking warning --no-telemetry",
    "check:dead": "knip",
    "check:dup": "jscpd packages",
    "check:tokens": "bash scripts/check-css-tokens.sh",
    "check:i18n": "bash scripts/check-i18n.sh",
    "check:sonar": "bash scripts/check-sonar-triage.sh",
    "check:shell": "node scripts/check-shell.ts",
    "modules:hint": "node scripts/modules-hint.ts",
    "sonar": "node scripts/sonar-issues.ts",
    "gate": "pnpm run \"/^(typecheck|check|check:arch|check:design|check:react|check:tokens|check:i18n|check:sonar|check:shell|test:coverage|check:dead|check:dup)$/\" && bash scripts/gate-stamp.sh write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@softarc/sheriff-core": "^0.19.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.0.4",
    "fast-check": "^4.8.0",
    "github-actionlint": "^1.7.12",
    "husky": "^9.1.7",
    "impeccable": "^3.5.0",
    "jscpd": "^5.0.14",
    "knip": "^6.29.0",
    "react-doctor": "^0.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.4"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.0": ">=0.6.0"
    }
  }
}
