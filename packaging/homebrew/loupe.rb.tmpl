# Homebrew formula template for the `loupe` binary (distribution D5).
# The release workflow substitutes {{VERSION}}, {{SHA_DARWIN_ARM64}} and
# {{SHA_LINUX_X64}} from the built archives, attaches the result to the
# GitHub Release, and pushes it to the tap repo when HOMEBREW_TAP_TOKEN is
# configured (see docs/RELEASING.md). This header is stripped at generation
# (everything above `class Loupe`): substituting on it used to publish a
# mangled first line.
class Loupe < Formula
  desc "Atelier de pratique musicale — serveur local + navigateur"
  homepage "https://github.com/IIIvan37/loupe"
  version "{{VERSION}}"

  on_macos do
    on_arm do
      url "https://github.com/IIIvan37/loupe/releases/download/v{{VERSION}}/loupe-v{{VERSION}}-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA_DARWIN_ARM64}}"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/IIIvan37/loupe/releases/download/v{{VERSION}}/loupe-v{{VERSION}}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA_LINUX_X64}}"
    end
  end

  def install
    bin.install "loupe"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/loupe --version")
  end
end
